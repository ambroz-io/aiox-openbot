{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "task_id",
    "attempt",
    "role",
    "project",
    "scope",
    "acceptance",
    "authorization",
    "inputs",
    "allowed_files"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "role": {
      "enum": [
        "dev",
        "qa",
        "architect",
        "analyst",
        "pm",
        "po",
        "sm",
        "data-engineer",
        "ux-design-expert",
        "devops",
        "squad-creator"
      ]
    },
    "project": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "authorization": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "allowed_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    }
  }
}
